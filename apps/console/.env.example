RAILS_ENV=production
RAILS_SERVE_STATIC_FILES=true
RAILS_LOG_TO_STDOUT=true
RAILS_ALLOWED_HOSTS=console.agevidence.com
DATABASE_URL=postgres://USER:PASSWORD@HOST:5432/agevidence
# Local examples:
# DATABASE_URL=postgres://postgres:postgres@localhost:5432/agevidence_development
# RAILS_ENV=test DATABASE_URL=postgres://postgres:postgres@localhost:5432/agevidence_test
RAILS_MASTER_KEY=replace-with-production-master-key
SECRET_KEY_BASE=replace-with-production-secret-key-base
DEVISE_MAILER_SENDER=no-reply@agevidence.com
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USERNAME=replace
SMTP_PASSWORD=replace
SENTRY_DSN=
JOB_CONCURRENCY=1
