<% page_title "Change password" %>

<div class="auth-page">
  <section class="auth-card panel">
    <%= link_to root_path, class: "brand-link auth-brand" do %>
      <span class="brand-mark" aria-hidden="true"></span>
      <span>AgEvidence</span>
    <% end %>

    <div class="auth-heading">
      <div class="eyebrow">Account recovery</div>
      <h1>Choose a new password</h1>
      <p>Use a strong password for access to the evidence console.</p>
    </div>

    <%= form_for(resource, as: resource_name, url: password_path(resource_name), html: { method: :put, class: "auth-form" }) do |form| %>
      <%= render "devise/shared/error_messages", resource: resource %>
      <%= form.hidden_field :reset_password_token %>

      <div>
        <%= form.label :password, "New password", class: "label" %>
        <%= form.password_field :password, autofocus: true, autocomplete: "new-password", required: true %>
      </div>

      <div>
        <%= form.label :password_confirmation, "Confirm new password", class: "label" %>
        <%= form.password_field :password_confirmation, autocomplete: "new-password", required: true %>
      </div>

      <%= form.submit "Change password", class: "button primary auth-submit" %>
    <% end %>
  </section>
</div>
