<% page_title "Profiles" %>
<%= render "shared/page_header",
  title: "Program Profiles",
  description: "Operational profile definitions maintained by the hosted Evidence Plane." %>
<%= render "programs/engine_tabs" %>

<div class="grid grid-2">
  <% @profiles.each do |profile| %>
    <section class="panel">
      <div style="display:flex;justify-content:space-between;gap:12px">
        <strong><%= profile.name %></strong>
        <%= badge(profile.status.upcase, tone: profile.status == "Operational" ? "success" : "warning", mono: true) %>
      </div>
      <%= key_values([
        ["Code", profile.code, true],
        ["Version", profile.profile_version, true],
        ["Requirements", profile.requirements_count, true],
        ["Machine", profile.machine_evaluable, true],
        ["Human / hybrid", profile.human_review, true],
        ["Effective", profile.effective_from&.strftime("%d %b %Y") || "n/a", true]
      ]) %>
    </section>
  <% end %>
</div>
