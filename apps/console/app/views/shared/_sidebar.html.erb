<div class="sidebar-brand">
  <%= link_to app_home_path, class: "brand-link" do %>
    <span class="brand-mark" aria-hidden="true"></span>
    <span><%= brand_product_name %></span>
  <% end %>
  <button class="icon-button mobile-only" type="button" data-sidebar-close aria-label="Close navigation">x</button>
</div>

<nav class="sidebar-nav">
  <% current_product_pack.navigation.visible_for(current_product_pack).each do |section| %>
    <div class="nav-section">
      <div class="nav-heading"><%= section.label %></div>
      <% section.items.each do |item| %>
        <%= nav_link portfolio_nav_path(item.target), item.label, badge: portfolio_nav_badge(item.target), exact: item.target == "dashboard", icon: item.label.first %>
      <% end %>
    </div>
  <% end %>
</nav>

<nav class="sidebar-bottom">
  <div class="nav-heading">Settings</div>
  <%= nav_link app_organization_path, "Organization", icon: "B" %>
  <%= nav_link app_settings_path, "Settings", icon: "S" %>
  <% if brand_attribution.present? %>
    <div class="nav-heading"><%= brand_attribution %></div>
  <% end %>
</nav>
