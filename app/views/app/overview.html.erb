<% page_title "Evidence Plane" %>
<%= render "shared/page_header",
  title: "Evidence Plane",
  description: "Continuous evaluation, review, statement generation, sharing and production integrity. DIT AgTech · Production",
  actions: safe_join([
    link_to("Ingestion", app_evidence_path, class: "button secondary small"),
    link_to("Evaluations", app_evaluations_path, class: "button secondary small"),
    link_to("Statements", app_statements_path, class: "button primary small")
  ]) %>

<section class="panel">
  <div class="grid grid-2">
    <div>
      <div class="section-title">Local / Free</div>
      <div class="metric-label">AgEvidence SDK</div>
      <div class="stack-sm" style="margin-top:12px">
        <% ["SourceRecord", "Observation", "InterventionEvent", "OperationalEvent", "ModelRun"].each do |primitive| %>
          <div class="mono"><%= primitive %></div>
        <% end %>
      </div>
    </div>
    <div>
      <div class="section-title">Hosted / Commercial</div>
      <div class="metric-label">Evidence Plane</div>
      <div class="stack-sm" style="margin-top:12px">
        <div class="mono">Ingest -> Evaluate -> Review</div>
        <div class="mono">Statement</div>
        <div class="mono">Share / API / Verify</div>
      </div>
    </div>
  </div>
  <div style="border-top:1px solid var(--border);margin-top:18px;padding-top:14px;text-align:center">
    <%= badge("OPTIONAL HOSTED CONNECTION", tone: "info", mono: true) %>
  </div>
</section>

<div class="grid grid-4" style="margin-top:16px">
  <% @plane_metrics.each do |group, rows| %>
    <section class="panel">
      <div class="section-title"><%= group.to_s.humanize.upcase %></div>
      <div class="stack-sm">
        <% rows.each do |value, label| %>
          <div class="metric">
            <div class="metric-value"><%= value %></div>
            <div class="metric-label"><%= label %></div>
          </div>
        <% end %>
      </div>
    </section>
  <% end %>
</div>

<div class="grid grid-main-side" style="margin-top:16px">
  <section class="panel">
    <div class="section-title">Operational status</div>
    <div class="stack-sm">
      <% @operational_health.each do |name, state, tone| %>
        <div class="list-row" style="display:flex;justify-content:space-between;gap:12px;align-items:center">
          <strong><%= name %></strong>
          <%= badge(state, tone: tone, mono: true) %>
        </div>
      <% end %>
    </div>
  </section>

  <section class="panel">
    <div class="section-title">Requires attention</div>
    <div class="stack-sm">
      <% @attention_items.each do |title, detail, url, status| %>
        <%= render "shared/evidence_instrument/basis_row",
          title: title,
          detail: detail,
          url: url,
          status: status,
          kicker: "Evidence Plane" %>
      <% end %>
    </div>
  </section>
</div>

<section class="panel" style="margin-top:16px">
  <div style="display:flex;justify-content:space-between;gap:12px;align-items:center;margin-bottom:12px">
    <div class="section-title" style="margin:0">Active statement</div>
    <%= link_to "Open statement", app_statement_path(@statement.artifact_code), class: "ei-basis-link" %>
  </div>
  <%= render "shared/evidence_instrument/evidence_plate",
    eyebrow: "Evidence Statement",
    title: @statement.claim,
    identifier: @statement.artifact_code,
    status: @statement.status,
    meta: [
      ["Digest", @statement.digest, true],
      ["Profile", @profile.profile_version, true],
      ["Integrity", "VALID", true],
      ["Qualification", "1", true]
    ],
    basis_url: app_statement_path(@statement.artifact_code) %>
</section>

<section class="panel" style="margin-top:16px">
  <div class="section-title">Causal activity</div>
  <%= render "shared/evidence_instrument/causal_timeline", items: @activities %>
</section>
