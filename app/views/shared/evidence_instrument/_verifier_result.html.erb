<section class="ei-verifier">
  <header>
    <div class="ei-kicker"><%= brand_product_name %> / Verify</div>
    <h1 class="mono"><%= artifact&.artifact_code || identifier %></h1>
    <%= ei_status(artifact ? (artifact.issued? ? "Valid issued statement" : "Valid draft statement") : "Statement not found", status: artifact ? "valid" : "material_gap") %>
  </header>

  <% if artifact %>
    <div class="ei-verifier-checks">
      <% ei_artifact_checks(artifact).each do |label, value, ok| %>
        <div>
          <span><%= label %></span>
          <strong class="mono"><%= value %></strong>
          <%= ei_status(ok ? "valid" : "draft") %>
        </div>
      <% end %>
    </div>

    <dl class="ei-plate-meta ei-verifier-meta">
      <div><dt><%= portfolio_term("Artifact") %> hash</dt><dd class="mono"><%= artifact.digest %></dd></div>
      <div><dt>Profile</dt><dd class="mono"><%= artifact.program %></dd></div>
      <div><dt>Boundary</dt><dd class="mono"><%= artifact.boundary %></dd></div>
      <div><dt>Issued</dt><dd class="mono"><%= artifact.issued? ? format_utc(artifact.issued_at) : "Not issued" %></dd></div>
    </dl>

    <div class="ei-verifier-boundary">
      <div>
        <div class="ei-kicker">This verifies</div>
        <p>Statement digest, canonical encoding, receipt chain, signature state, and supersession or revocation state recorded by this system.</p>
      </div>
      <div>
        <div class="ei-kicker">This does not assert</div>
        <p>Scientific validity, legal compliance, program eligibility, regulatory approval, or claim truth.</p>
      </div>
    </div>
  <% else %>
    <p>No <%= portfolio_term("Artifact") %> exists for <span class="mono"><%= identifier %></span> in this demo workspace.</p>
  <% end %>
</section>
