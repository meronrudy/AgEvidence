<% page_title "Program Profiles" %>
<%= render "shared/page_header",
  title: "Program Profiles",
  description: "Maintained profile infrastructure used by continuous evaluation and statement lifecycle checks." %>
<%= render "programs/engine_tabs" %>

<section class="stack-sm">
  <% @profiles.each do |profile| %>
    <%= render "shared/evidence_instrument/evidence_plate",
      eyebrow: "Program profile",
      title: profile.name,
      identifier: "#{profile.profile_version} / #{profile.status.upcase}",
      status: profile.status,
      meta: [
        ["Requirements", profile.requirements_count, true],
        ["Machine", profile.machine_evaluable, true],
        ["Human / hybrid", profile.human_review, true],
        ["Last maintained", profile.effective_from&.strftime("%d %b %Y") || "n/a", true]
      ],
      basis_url: app_program_profiles_path %>
  <% end %>
</section>
