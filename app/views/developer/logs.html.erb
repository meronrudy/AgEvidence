<% page_title "API logs" %>
<%= render "shared/page_header", title: "Developer Platform", description: "Every API request with status, duration, operation ID, and full processing trace." %>
<%= render "developer/tabs" %>

<div class="grid grid-main-side">
  <section class="panel flush">
    <div class="table-wrap">
      <table class="data-table">
        <thead><tr><th>Method</th><th>Endpoint</th><th>Status</th><th>Duration</th><th>Timestamp</th><th>Operation</th></tr></thead>
        <tbody>
          <% @logs.each do |log| %>
            <tr data-row-link="<%= app_developer_logs_path(selected: log.log_code) %>">
              <td class="mono"><%= log.method %></td>
              <td class="mono"><%= log.endpoint %></td>
              <td><%= badge("#{log.status}", tone: status_tone(log.status), mono: true) %></td>
              <td class="mono muted"><%= log.duration_ms %>ms</td>
              <td class="mono muted"><%= format_utc(log.occurred_at) %></td>
              <td class="mono muted"><%= log.operation_id %></td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  </section>
  <section class="panel">
    <% if @selected_log %>
      <div class="section-title">Request <%= @selected_log.log_code %></div>
      <%= key_values([
        ["Method", @selected_log.method, true],
        ["Endpoint", @selected_log.endpoint, true],
        ["Status", @selected_log.status, true],
        ["Duration", "#{@selected_log.duration_ms}ms", true],
        ["Operation", @selected_log.operation_id, true]
      ]) %>
      <div class="section-title" style="margin-top:18px">Trace</div>
      <%= render "shared/json_block", value: @selected_log.trace %>
      <div class="section-title" style="margin-top:18px">Response</div>
      <%= render "shared/json_block", value: @selected_log.response %>
    <% end %>
  </section>
</div>
