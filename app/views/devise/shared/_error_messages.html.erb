<% if resource.errors.any? %>
  <div class="flash flash-alert auth-errors">
    <strong><%= pluralize(resource.errors.count, "error") %> prevented this request.</strong>
    <ul>
      <% resource.errors.full_messages.each do |message| %>
        <li><%= message %></li>
      <% end %>
    </ul>
  </div>
<% end %>
