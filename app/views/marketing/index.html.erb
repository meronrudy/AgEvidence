<% page_title "Portable evidence infrastructure" %>
<header class="landing-header">
  <%= link_to root_path, class: "brand-link" do %>
    <span class="brand-mark" aria-hidden="true"></span>
    <span>AgEvidence</span>
  <% end %>
  <div class="header-actions">
    <%= link_to "Verify a statement", verify_path, class: "button secondary small" %>
    <%= link_to "Open console", app_home_path, class: "button primary small" %>
  </div>
</header>

<main class="landing-main">
  <%= badge("Australia / Methane intervention evidence / Beef", tone: "accent", dot: true) %>
  <h1 class="landing-title">Portable evidence infrastructure for agricultural climate programs</h1>
  <p class="lead">
    AgEvidence keeps canonical evidence operating after the free SDK emits it: continuous ingestion,
    evaluation, human review, determinations, Evidence Statements, sharing, and public integrity checks.
  </p>

  <div class="header-actions" style="justify-content:flex-start;margin-top:26px">
    <%= link_to "Open the console", app_home_path, class: "button primary" %>
    <%= link_to "Verify AE-AU-000184", verify_artifact_path("AE-AU-000184"), class: "button secondary" %>
  </div>

  <div class="flow">
    <% @flow.each_with_index do |step, index| %>
      <span class="flow-item">
        <span class="flow-step mono"><%= step %></span>
        <% if index < @flow.length - 1 %>
          <span class="flow-arrow" aria-hidden="true">-&gt;</span>
        <% end %>
      </span>
    <% end %>
  </div>

  <div class="grid grid-2" style="margin-top:48px">
    <% [
      ["What evidence do we have?", "Every operational event, source record, and model run, normalized with a digest."],
      ["What is missing or questionable?", "Country-profile requirements evaluated continuously into ranked, explainable gaps."],
      ["Who reviewed or transformed it?", "Append-only review decisions, determinations, and receipts for every state change."],
      ["What can be shared externally?", "A bounded Evidence Statement a recipient can inspect through public verification without internal system access."]
    ].each do |question, answer| %>
      <section class="panel">
        <div class="section-title"><%= question %></div>
        <p class="muted"><%= answer %></p>
      </section>
    <% end %>
  </div>
</main>
